    "audit": "node scripts/seo-audit.js",
    "watermark": "python scripts/watermark.py"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@vercel/blob": "2.8.2",
    "nodemailer": "10.3.1"
  },
  "overrides": {
    "zod": "4.6.6"
  }
}
