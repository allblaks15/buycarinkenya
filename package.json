{
  "name": "buycarinkenya",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Buy Car in Kenya - car import website and used car marketplace for Kenya",
  "scripts": {
    "images": "python scripts/fetch_images.py",
